[Unit]
Description=Release Watcher due scan
Documentation=https://github.com/HaidaDaniel/release-watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment="RELEASE_WATCHER_STATE_DIR=%h/.local/share/release-watcher"
EnvironmentFile=-"%h/.config/release-watcher/env"
ExecStart="%h/.local/bin/release-watcher" scan --due --json
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=30min
