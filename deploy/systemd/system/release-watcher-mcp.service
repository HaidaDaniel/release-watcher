[Unit]
Description=Release Watcher MCP Streamable HTTP server
Documentation=https://github.com/HaidaDaniel/release-watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=release-watcher
Group=release-watcher
WorkingDirectory=/var/lib/release-watcher
Environment="RELEASE_WATCHER_STATE_DIR=/var/lib/release-watcher"
Environment="RELEASE_WATCHER_MCP_LISTEN=127.0.0.1:8741"
EnvironmentFile=-/etc/release-watcher/environment
EnvironmentFile=-/etc/release-watcher/mcp.env
ExecStart=/opt/release-watcher/current/release-watcher mcp serve
Restart=on-failure
RestartSec=5s
StartLimitBurst=5
TimeoutStopSec=20s
UMask=0077
StateDirectory=release-watcher
StateDirectoryMode=0700
ReadWritePaths=/var/lib/release-watcher

MemoryAccounting=yes
MemoryHigh=128M
MemoryMax=256M
MemorySwapMax=128M
CPUAccounting=yes
CPUQuota=25%
CPUWeight=50
TasksAccounting=yes
TasksMax=64
IOAccounting=yes
IOWeight=50
Nice=10
IOSchedulingClass=idle
LimitNOFILE=4096

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
